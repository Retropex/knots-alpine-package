# Contributor: Léo Haf <leo@haf.ovh>
# Maintainer: Léo Haf <leo@haf.ovh>
pkgname=datum-gateway
pkgver=0.4.1
pkgrel=0
pkgdesc="Decentralized Alternative Templates for Universal Mining"
url="https://ocean.xyz"
arch="x86_64 aarch64"
license="MIT"
depends="curl-dev jansson-dev libsodium-dev libmicrohttpd-dev psmisc jq bitcoin-knots"
makedepends="build-base cmake pkgconf argp-standalone curl-dev jansson-dev libsodium-dev libmicrohttpd-dev psmisc"
options="!check"
pkgusers="bitcoin"
pkggroups="bitcoin"
install="$pkgname.pre-install $pkgname.post-install $pkgname.post-deinstall"
source="
	datum_gateway_v0.4.1.tar.gz::https://github.com/OCEAN-xyz/datum_gateway/archive/refs/tags/v0.4.1beta.tar.gz
	datum-gateway.initd
	datum-gateway.confd
	"
builddir="$srcdir/datum_gateway-0.4.1beta"
build() {
	cmake -G "Unix Makefiles" .
	make -j "$(nproc)"
}

package() {
	install -m 555 -D "$builddir"/datum_gateway \
		"$pkgdir"/usr/bin/datum_gateway
	install -m600 -o bitcoin -g bitcoin -D "$builddir"/doc/example_datum_gateway_config.json \
		"$pkgdir"/etc/datum/config.json
	install -m755 -D "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname
	install -m644 -D "$srcdir"/$pkgname.confd \
		"$pkgdir"/etc/conf.d/$pkgname
}

sha512sums="
