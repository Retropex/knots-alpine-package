# Contributor: Léo Haf <leo@haf.ovh>
# Maintainer: Léo Haf <leo@haf.ovh>
pkgname=bitcoin-knots
pkgver=29.3
_pkgverlong=29.3.knots20260210
pkgrel=0
pkgdesc="enhanced Bitcoin node/wallet software"
url="https://bitcoinknots.org"
arch="x86_64 aarch64"
license="MIT"
depends="gcc g++ python3 sqlite-dev zeromq-dev boost-dev libevent-dev db-dev miniupnpc-dev"
makedepends="cmake gcc python3 sqlite-dev zeromq-dev boost-dev libevent-dev db-dev miniupnpc-dev"
checkdepends="cmake gcc python3 sqlite-dev zeromq-dev boost-dev libevent-dev db-dev miniupnpc-dev"
install="$pkgname.pre-install $pkgname.post-deinstall"
subpackages="$pkgname-doc"
source="
	$pkgname-$_pkgverlong.tar.gz::https://bitcoinknots.org/files/29.x/$_pkgverlong/bitcoin-$_pkgverlong.tar.gz
	bitcoin-knots.initd
	bitcoin-knots.confd
	bitcoin-knots.pre-install
	bitcoin-knots.post-deinstall
	"
builddir="$srcdir/bitcoin-$_pkgverlong"

build() {
	default_prepare
	cmake -B build -G "Unix Makefiles" -DWITH_ZMQ=ON -DWITH_BDB=ON -DWITH_MINIUPNPC=ON -DWARN_INCOMPATIBLE_BDB=OFF
	cmake --build build -j "$(nproc)"
	:
}

check() {
	ctest --test-dir build -j "$(nproc)"
	:
}

package() {
	cmake --install build --prefix "$pkgdir"/usr
	:

	install -m755 -D "$srcdir"/$pkgname.initd \
		"$pkgdir"/etc/init.d/$pkgname
	install -m644 -D "$srcdir"/$pkgname.confd \
		"$pkgdir"/etc/conf.d/$pkgname
}

